# Google Gemini (optional — without a key TraceX uses its built-in local diagnosis engine)
GEMINI_API_KEY="your_api_key_here"
GEMINI_MODEL=gemini-2.0-flash

# Secret used to seal challenge tokens (so hidden tests never reach the browser).
# Set to any long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
